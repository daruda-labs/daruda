+fn selected_range_for_marked_text(
+    marked_range: Range<usize>,
+    new_text: &str,
+    new_selected_range_utf16: Option<&Range<usize>>,
+) -> Range<usize> {
+    // AppKit's selectedRange for setMarkedText is relative to the marked string.
+    let Some(new_selected_range_utf16) = new_selected_range_utf16 else {
+        return marked_range.end..marked_range.end;
+    };
+
+    let start = utf16_offset_to_byte_offset(new_text, new_selected_range_utf16.start, Bias::Left);
+    let end = utf16_offset_to_byte_offset(new_text, new_selected_range_utf16.end, Bias::Right);
+    marked_range.start + start..marked_range.start + end
+}
+
+fn utf16_offset_to_byte_offset(text: &str, offset_utf16: usize, bias: Bias) -> usize {
+    let mut current_utf16 = 0;
+    for (byte_offset, ch) in text.char_indices() {
+        if offset_utf16 == current_utf16 {
+            return byte_offset;
+        }
+
+        let next_utf16 = current_utf16 + ch.len_utf16();
+        if offset_utf16 < next_utf16 {
+            return if bias == Bias::Left {
+                byte_offset
+            } else {
+                byte_offset + ch.len_utf8()
+            };
+        }
+        current_utf16 = next_utf16;
+    }
+
+    text.len()
+}
+
+#[cfg(test)]
+mod ime_tests {
+    use super::*;
+
+    #[test]
+    fn hangul_marked_selection_uses_utf8_width_not_document_utf16_offset() {
+        assert_eq!(
+            selected_range_for_marked_text(140..143, "음", Some(&(1..1))),
+            143..143
+        );
+    }
+}
